# Runtime
PORT=5000
NODE_ENV=production
# One reverse-proxy hop (nginx, Render, Railway). Use false if directly exposed.
TRUST_PROXY=1

# Database and sessions
MONGODB_URI=mongodb://127.0.0.1:27017/bizassist
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_DAYS=7

# Browser origins. FRONTEND_URL is always allowed; add extras comma-separated.
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=

# Local AI
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:2b

# Password reset email (optional; without it the reset link is logged)
RESEND_API_KEY=
EMAIL_FROM=BizAssist AI <onboarding@resend.dev>

# Set only for local testing to return the reset token in the API response.
AUTH_RESET_DEBUG=false
