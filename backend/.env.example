# Runtime
PORT=5000
NODE_ENV=production
# One reverse-proxy hop (nginx, Render, Railway). Use false if directly exposed.
TRUST_PROXY=1

# Database and sessions
MONGODB_URI=mongodb://127.0.0.1:27017/bizassist
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_DAYS=7

# Browser origins. FRONTEND_URL is always allowed; add extras comma-separated.
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=

# Local AI
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:2b

# WhatsApp provider: waapi or meta. Blank = auto-detect (WaAPI when WAAPI_TOKEN is set).
WHATSAPP_PROVIDER=waapi
# Business WhatsApp number, digits only.
WHATSAPP_PHONE=
# Optional: MongoDB _id of this Business, used to route webhooks when no other match exists.
WHATSAPP_BUSINESS_ID=

# --- WaAPI (waapi.app) -------------------------------------------------------
# Token from https://waapi.app/user/api-tokens
WAAPI_TOKEN=
# Instance id from the WaAPI dashboard (Instances -> ID)
WAAPI_INSTANCE_ID=
# Secret embedded in the webhook URL: /api/whatsapp/waapi/<secret>
WAAPI_WEBHOOK_SECRET=
# Public HTTPS URL shown in Settings. Blank = derived from the request host.
WAAPI_WEBHOOK_URL=

# --- Meta WhatsApp Cloud API (only used when provider = meta) ---------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v20.0
WHATSAPP_WEBHOOK_URL=

# Password reset email (optional; without it the reset link is logged)
RESEND_API_KEY=
EMAIL_FROM=BizAssist AI <onboarding@resend.dev>

# Set only for local testing to return the reset token in the API response.
AUTH_RESET_DEBUG=false
